          {
            "method": "control",
            "seed": 0,
            "path": "${RUN}/source/models/control/seed_0/best.pt"
          },
          {
            "method": "control",
            "seed": 1,
            "path": "${RUN}/source/models/control/seed_1/best.pt"
          },
          {
            "method": "control",
            "seed": 2,
            "path": "${RUN}/source/models/control/seed_2/best.pt"
          },
