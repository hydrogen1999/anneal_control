            "method": "policy",
            "seed": 3,
            "path": "${RUN}/source/models/policy/seed_3/best.pt"
          },
          {
            "method": "policy",
            "seed": 4,
            "path": "${RUN}/source/models/policy/seed_4/best.pt"
          }
        ],
        "targets": [
          {
            "name": "source_heldout",
            "data": "${RUN}/source/data",
            "axes": [
              "heldout_parents"
            ]
          },
          {
            "name": "pegasus",
            "data": "${RUN}/pegasus",
            "axes": [
              "topology"
            ]
          },
          {
            "name": "zephyr",
            "data": "${RUN}/zephyr",
            "axes": [
              "topology"
            ]
          },
          {
            "name": "unseen_family",
            "data": "${RUN}/unseen_family",
            "axes": [
              "family"
            ]
          },
          {
            "name": "unseen_runtime",
            "data": "${RUN}/unseen_runtime",
            "axes": [
              "runtime"
            ]
          },
          {
            "name": "unseen_size",
            "data": "${RUN}/unseen_size",
            "axes": [
              "physical_size"
            ]
          }
        ],
        "device": "cuda",
        "threads": 1,
        "bootstrap_resamples": 10000
      },
      "output": "transfer",
      "depends": [
        "source",
        "pegasus",
        "zephyr",
        "unseen_family",
        "unseen_runtime",
        "unseen_size"
      ]
