    {
      "id": "budget_control_0",
      "kind": "budget",
      "config": {
        "schema_version": 1,
        "source_data": "${RUN}/source/data",
        "target_data": "${RUN}/source/data",
        "checkpoint": "${RUN}/source/models/control/seed_0/best.pt",
        "split": "test",
        "allow_test_adaptation": true,
        "budgets": [
          0,
          2,
          5,
          9,
          17,
          33,
          65,
          129,
          257
        ],
        "seeds": [
          0,
          1,
          2
        ],
        "strategies": [
          "sobol_local",
          "bayesian",
          "finzgar_gp_ucb"
        ],
        "warm_modes": [
          "bank",
          "direct",
          "source_global"
        ],
        "hint_mode": "project",
        "family": "eight_bin",
        "execution": {
          "device": "cuda",
          "backend": "cupy",
          "threads": 1
        },
        "numerics": {
          "tolerance": 0.0002,
          "initial_steps": 64,
          "max_steps": 16384
        },
        "literature": {
          "n_initial": 10,
          "acquisition_candidates": 1024,
          "acquisition_restarts": 3,
          "gp_restarts": 3
        },
        "latency": {
          "warmup": 1,
          "repeats": 3
        },
        "bootstrap_resamples": 2000,
        "offline_cost": {
          "acquisition_study": "${RUN}/source",
          "fixed_recipe": true
        },
        "quality_thresholds": [
          0.4,
          0.5,
          0.6
        ]
