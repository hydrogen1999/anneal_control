{
  "schema_version": 1,
  "name": "controlled_annealing_research",
  "scope": "Predeclared confirmatory candidate; execution and favorable findings are not assumed. Review compute feasibility before full execution.",
  "steps": [
    {
      "id": "source",
      "kind": "acquisition",
      "config": "paper_source_research.json",
      "output": "source"
    },
    {
      "id": "pegasus",
      "kind": "generate",
      "config": "paper_target_pegasus.json",
      "output": "pegasus",
      "depends": [
        "source"
      ],
      "backend": "cupy",
      "workers": 1
    },
    {
      "id": "zephyr",
      "kind": "generate",
      "config": "paper_target_zephyr.json",
      "output": "zephyr",
      "depends": [
        "source"
      ],
      "backend": "cupy",
      "workers": 1
    },
    {
      "id": "unseen_family",
      "kind": "generate",
      "config": "paper_target_family_research.json",
